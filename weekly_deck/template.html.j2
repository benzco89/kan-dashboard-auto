<!DOCTYPE html>
<html lang="he">
<head>
<meta charset="utf-8">
{#
  Flat, self-contained render of weekly-social-light.dc.html for PDF.
  The interactive x-dc / x-import / deck-stage scaffolding is stripped: the
  <section>s are stacked vertically, each exactly 1920x1080 with a page break
  after it. Fonts are loaded from local OTF files (only the weights that exist
  on disk — the Light/300 weight is licensed-optional and absent here, so the
  browser maps 300 to the nearest available weight). Every image (thumbnails +
  logo) is inlined as a data URI so rendering never touches the network.
  Values come from generate_deck.py; the markup/inline-styles mirror the design.
#}
<style>
{% for f in font_faces -%}
@font-face{font-family:'SimplerPro';src:url('{{ f.uri }}') format('opentype');font-weight:{{ f.weight }};font-display:swap}
{% endfor -%}
*{box-sizing:border-box}
html,body{margin:0;padding:0;background:#f4f4f4}
.slide{width:1920px;height:1080px;overflow:hidden;position:relative;page-break-after:always;break-after:page}
.slide:last-child{page-break-after:auto;break-after:auto}
.mono{font-family:'SF Mono',Menlo,Consolas,'Courier New',monospace}
</style>
</head>
<body>

{#=== macros are defined first so top-level slides can call them ===#}
{#
  Brand lockup: the Kan square mark (right, RTL) + a SimplerPro wordmark to its
  left — geometry matches the original design's logo lockup.
  Priority: full pre-composed PNG > SVG mark + wordmark > pure typographic.
#}
{% macro logo_lockup(h) %}
{%- if logo_black -%}
<img src="{{ logo_black }}" alt="כאן חדשות" style="height:{{ h }}px;width:auto;opacity:.95">
{%- elif mark -%}
<div style="display:inline-flex;align-items:center;gap:{{ (h*0.32)|round|int }}px;height:{{ h }}px;font-family:'SimplerPro',sans-serif"><svg viewBox="{{ mark.viewbox }}" width="{{ h }}" height="{{ h }}" style="display:block;flex-shrink:0" role="img" aria-label="כאן חדשות"><path d="{{ mark.d }}" fill="{{ mark.fill }}"></path></svg><span style="font-size:{{ (h*0.62)|round|int }}px;line-height:1;color:#111;letter-spacing:-.02em"><span style="font-weight:900">כאן</span> <span style="font-weight:700">חדשות</span></span></div>
{%- else -%}
<div style="display:inline-flex;align-items:center;gap:{{ (h*0.28)|round|int }}px;height:{{ h }}px;opacity:.95;font-family:'SimplerPro',sans-serif"><span style="background:#111;color:#fff;font-weight:900;font-size:{{ (h*0.62)|round|int }}px;line-height:1;padding:{{ (h*0.16)|round|int }}px {{ (h*0.22)|round|int }}px;border-radius:{{ (h*0.14)|round|int }}px;letter-spacing:-.02em">כאן</span><span style="font-weight:700;font-size:{{ (h*0.5)|round|int }}px;color:#111;letter-spacing:-.01em">חדשות</span></div>
{%- endif -%}
{% endmacro %}

{% macro platform_slide(p) %}
<section class="slide" dir="rtl" style="background:#f4f4f4;font-family:'SimplerPro',sans-serif;color:#111;padding:60px 80px 52px;display:flex;flex-direction:column">
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px"><div style="display:flex;align-items:center;gap:20px">{{ p.icon }}<div><div style="font-size:15px;font-weight:700;letter-spacing:.05em;color:#FF3300">{{ p.rank_label }}</div><h2 style="margin:2px 0 0;font-size:46px;font-weight:900;letter-spacing:-.02em">{{ p.name }}</h2></div></div>
    <div style="display:flex;gap:44px;align-items:center"><div style="text-align:center"><div class="mono" style="font-size:42px;font-weight:700;line-height:1">{{ p.weekly_views_fmt }}</div><div style="font-size:15px;color:#808080;margin-top:4px">צפיות השבוע</div></div><div style="width:1px;height:50px;background:#e0e0e0"></div><div style="text-align:center"><div class="mono" style="font-size:42px;font-weight:700;line-height:1;color:{{ p.delta_color }}">{% if p.has_delta %}{{ p.delta_str }}{% else %}—{% endif %}</div><div style="font-size:15px;color:#808080;margin-top:4px">מול שבוע שעבר</div></div></div></div>

  {% if not p.has_data %}
  <div style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#808080;gap:18px">
    <div style="opacity:.45">{{ p.icon_big }}</div>
    <div style="font-size:30px;font-weight:700;color:#404040">אין פרסומים ב{{ p.name }} השבוע</div>
    <div style="font-size:19px">לא נאספו נתונים לחלון {{ week.range_short }}</div>
  </div>
  {% else %}
  <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-bottom:18px">
    {% for c in p.top3 %}<div style="background:#ffffff;border:1px solid #e0e0e0;border-radius:8px;overflow:hidden;position:relative;display:flex;flex-direction:column">
      <div style="position:relative;width:100%;height:172px;background:#e8e8e8">{% if c.thumb %}<img src="{{ c.thumb }}" alt="" style="width:100%;height:100%;object-fit:cover;display:block">{% else %}<div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#eee,#e2e2e2)"><div style="opacity:.35">{{ p.icon_big }}</div></div>{% endif %}<div style="position:absolute;top:14px;right:14px;font-size:36px;filter:drop-shadow(0 2px 4px rgba(0,0,0,.6))">{{ c.medal }}</div></div>
      <div style="padding:14px 22px 16px;display:flex;flex-direction:column;gap:8px;flex:1"><div style="font-size:20px;font-weight:700;line-height:1.2;text-wrap:pretty">{{ c.title }}</div>
        <div style="margin-top:auto;display:flex;align-items:center;justify-content:space-between"><div style="display:flex;align-items:baseline;gap:7px"><span class="mono" style="font-size:32px;font-weight:700;color:{{ p.colors.accent }}">{{ c.views_fmt }}</span><span style="font-size:15px;color:#808080">צפיות</span></div>{% if c.reporter %}<div style="font-size:15px;color:#808080;display:flex;align-items:center;gap:7px"><span style="width:6px;height:6px;border-radius:50%;background:#FF3300"></span>{{ c.reporter }}</div>{% endif %}</div></div></div>
    {% endfor %}
  </div>

  {% if p.has_anomaly %}<div style="display:flex;align-items:center;gap:10px;font-size:14px;color:#808080;margin-bottom:8px"><span style="font-size:11px;font-weight:700;color:#fff;background:#FF3300;border-radius:99px;padding:2px 7px">חריג</span> מעורבות גבוהה במיוחד ביחס לדירוג הצפיות</div>{% else %}<div style="margin-bottom:8px;height:23px"></div>{% endif %}

  <div style="flex:1;display:flex;gap:22px;min-height:0"><div style="flex:1;display:flex;flex-direction:column;min-height:0">
    <div style="display:grid;grid-template-columns:44px 1fr 150px 108px 132px;gap:14px;padding:0 18px 6px;font-size:13px;font-weight:700;color:#808080;letter-spacing:.03em"><div>#</div><div>כותרת</div><div>כתב/ת</div><div style="text-align:left">צפיות</div><div style="text-align:left">מעורבות</div></div>
    <div style="display:flex;flex-direction:column;gap:4px;flex:1">
      {% for row in p.top10 %}
      {%- if row.highlight -%}
        {%- set alpha = {1:'0.16',2:'0.11',3:'0.07'}[row.rank] -%}
        <div style="display:grid;grid-template-columns:44px 1fr 150px 108px 132px;gap:14px;align-items:center;padding:7px 18px;background:rgba({{ p.colors.tint }},{{ alpha }});border-right:3px solid {{ p.colors.bar }};border-radius:4px"><div class="mono" style="font-size:21px;font-weight:700">{{ row.rank }}</div><div style="font-size:18px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{{ row.title }}</div><div style="font-size:16px;color:#404040;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{{ row.reporter }}</div><div class="mono" style="text-align:left;font-size:19px;font-weight:700">{{ row.views_fmt }}</div><div style="text-align:left;font-size:17px;color:#404040">{{ row.eng_str }}</div></div>
      {%- elif row.anomaly -%}
        <div style="display:grid;grid-template-columns:44px 1fr 150px 108px 132px;gap:14px;align-items:center;padding:6px 18px;background:rgba(255,51,0,0.07);border-right:3px solid #FF3300;border-radius:4px"><div class="mono" style="font-size:19px;color:#808080">{{ row.rank }}</div><div style="font-size:17px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{{ row.title }}</div><div style="font-size:15px;color:#808080;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{{ row.reporter }}</div><div class="mono" style="text-align:left;font-size:18px">{{ row.views_fmt }}</div><div style="text-align:left"><span style="font-weight:700;color:#FF3300">{{ row.eng_str }}</span> <span style="font-size:11px;font-weight:700;color:#fff;background:#FF3300;border-radius:99px;padding:2px 7px;margin-right:6px">חריג</span></div></div>
      {%- else -%}
        <div style="display:grid;grid-template-columns:44px 1fr 150px 108px 132px;gap:14px;align-items:center;padding:6px 18px;border-bottom:1px solid #e0e0e0"><div class="mono" style="font-size:19px;color:#808080">{{ row.rank }}</div><div style="font-size:17px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{{ row.title }}</div><div style="font-size:15px;color:#808080;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{{ row.reporter }}</div><div class="mono" style="text-align:left;font-size:18px">{{ row.views_fmt }}</div><div style="text-align:left;font-size:17px;color:#404040">{{ row.eng_str }}</div></div>
      {%- endif -%}
      {% endfor %}
    </div></div>
    {% if p.fun_fact %}<div style="width:296px;flex-shrink:0;background:linear-gradient(180deg,rgba({{ p.colors.tint }},.10),rgba({{ p.colors.tint }},.02));border:1px solid rgba({{ p.colors.tint }},.28);border-radius:8px;padding:26px;display:flex;flex-direction:column"><div style="font-size:15px;font-weight:700;letter-spacing:.04em;color:{{ p.colors.accent }};margin-bottom:16px">נתון מעניין</div><div class="mono" style="font-size:70px;font-weight:700;line-height:.9;color:#111">{{ p.fun_fact.value }}<span style="font-size:38px;color:{{ p.colors.accent }}">{{ p.fun_fact.suffix }}</span></div><div style="font-size:20px;line-height:1.4;color:#404040;margin-top:16px;text-wrap:pretty">{{ p.fun_fact.text }}</div></div>{% endif %}
  </div>
  {% endif %}
</section>
{% endmacro %}

{#================= COVER =================#}
<section class="slide" dir="rtl" style="background:radial-gradient(120% 120% at 78% 12%,#ffffff 0%,#f7f7f7 55%,#ececec 100%);font-family:'SimplerPro',sans-serif;color:#111;padding:96px 110px;display:flex;flex-direction:column;justify-content:space-between">
  <div style="position:absolute;top:0;right:0;width:8px;height:100%;background:#FF3300"></div>
  <div style="display:flex;align-items:flex-start;justify-content:space-between">
    <div>
      <div style="font-size:22px;font-weight:700;letter-spacing:.04em;color:#FF3300;margin-bottom:26px">סיכום סושיאל שבועי</div>
      <h1 style="margin:0;font-size:104px;font-weight:900;line-height:.98;letter-spacing:-.02em">הסושיאל<br>של השבוע</h1>
      <div style="margin-top:30px;font-size:30px;font-weight:400;color:#404040">{{ week.range_str }}</div>
    </div>
    {{ logo_lockup(58) }}
  </div>
  <div style="display:flex;align-items:flex-end;justify-content:space-between;border-top:1px solid #e0e0e0;padding-top:44px">
    <div>
      <div style="font-size:24px;font-weight:600;color:#808080;margin-bottom:8px">סה״כ צפיות בכל הפלטפורמות</div>
      <div class="mono" style="font-size:200px;font-weight:700;line-height:.85;letter-spacing:-.03em;color:#111">{{ hero.total_main }}<span style="font-size:96px;color:#FF3300">{{ hero.total_suffix }}</span></div>
    </div>
    {% if hero.has_delta %}<div style="text-align:left;display:flex;align-items:center;gap:12px;color:{{ hero.delta_color }};font-size:30px;font-weight:700"><span style="font-size:34px">{{ hero.delta_arrow }}</span>{{ hero.delta_str }} מול השבוע שעבר</div>{% endif %}
  </div>
</section>

{#================= OVERVIEW =================#}
<section class="slide" dir="rtl" style="background:#f4f4f4;font-family:'SimplerPro',sans-serif;color:#111;padding:84px 96px;display:flex;flex-direction:column">
  <div style="display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:8px">
    <div style="display:flex;align-items:baseline;gap:20px"><div style="width:44px;height:8px;background:#FF3300;align-self:center"></div><h2 style="margin:0;font-size:60px;font-weight:900;letter-spacing:-.02em">השבוע במספרים</h2></div>
    <div style="text-align:left"><div class="mono" style="font-size:52px;font-weight:700;line-height:1">{{ hero.total_fmt }}</div><div style="font-size:16px;color:#808080;margin-top:2px">סה״כ צפיות{% if hero.has_delta %} · <span style="color:{{ hero.delta_color }};font-weight:700">{{ hero.delta_arrow }} {{ hero.delta_str }}</span> מהשבוע שעבר{% endif %}</div></div></div>
  <div style="font-size:20px;color:#808080;margin-bottom:12px">מדורג לפי נפח צפיות — אורך הבר = נתח מסך הצפיות</div>
  <div style="display:grid;grid-template-columns:250px 1fr 130px 120px;gap:26px;padding:0 2px 14px;border-bottom:1px solid #e0e0e0;font-size:14px;font-weight:700;color:#808080;letter-spacing:.03em"><div>פלטפורמה</div><div>נתח מסך הצפיות</div><div>צפיות השבוע</div><div style="text-align:left">מגמה</div></div>
  <div style="flex:1;display:flex;flex-direction:column;justify-content:space-around;padding:10px 0">
    {% for r in overview_rows %}<div style="display:grid;grid-template-columns:250px 1fr 130px 120px;gap:26px;align-items:center">
      <div style="display:flex;align-items:center;gap:16px">{{ r.icon }}<div><div style="font-size:27px;font-weight:700">{{ r.name }}</div><div style="font-size:15px;color:#808080;margin-top:2px">{% if r.followers_fmt %}{{ r.followers_fmt }} עוקבים{% endif %}</div></div></div>
      <div style="position:relative;height:42px;background:#e0e0e0;border-radius:8px;overflow:hidden"><div style="position:absolute;top:0;right:0;height:100%;width:{{ r.bar_pct }}%;background:{{ r.bar_color }};border-radius:8px"></div></div>
      <div class="mono" style="font-size:32px;font-weight:700">{{ r.views_fmt }}</div>
      <div style="font-size:18px;font-weight:700;color:{{ r.delta_color }};text-align:left">{% if r.has_delta %}{{ r.delta_arrow }} {{ r.delta_str }}{% else %}—{% endif %}</div></div>
    {% endfor %}
  </div>
</section>

{#================= PLATFORM SLIDES =================#}
{% for p in platforms %}{{ platform_slide(p) }}{% endfor %}

{#================= LEARNINGS =================#}
<section class="slide" dir="rtl" style="background:radial-gradient(120% 120% at 22% 10%,#ffffff 0%,#f4f4f4 60%,#e9e9e9 100%);font-family:'SimplerPro',sans-serif;color:#111;padding:84px 96px;display:flex;flex-direction:column">
  <div style="display:flex;align-items:baseline;gap:20px;margin-bottom:44px"><div style="width:44px;height:8px;background:#FF3300;align-self:center"></div><h2 style="margin:0;font-size:60px;font-weight:900;letter-spacing:-.02em">מה למדנו השבוע</h2></div>
  <div style="flex:1;display:grid;grid-template-columns:1.25fr 1fr;gap:28px">
    <div style="background:#ffffff;border:1px solid #e0e0e0;border-radius:8px;padding:56px 52px;display:flex;flex-direction:column;position:relative;overflow:hidden"><div style="position:absolute;top:0;right:0;width:8px;height:100%;background:#FF3300"></div><div style="font-size:44px;line-height:1">{{ learnings.primary.emoji }}</div>{% if learnings.primary.stat %}<div class="mono" style="font-size:150px;font-weight:700;line-height:.85;color:{{ learnings.primary.stat_color }};margin-top:20px">{{ learnings.primary.stat_main }}<span style="font-size:80px">{{ learnings.primary.stat_suffix }}</span></div>{% endif %}<div style="font-size:42px;font-weight:900;line-height:1.1;letter-spacing:-.01em;margin-top:28px;text-wrap:pretty">{{ learnings.primary.headline }}</div><div style="margin-top:auto;font-size:22px;color:#404040;line-height:1.5;padding-top:24px">{{ learnings.primary.body }}</div></div>
    <div style="display:grid;grid-template-rows:1fr 1fr;gap:28px">
      {% for s in learnings.secondary %}<div style="background:#ffffff;border:1px solid #e0e0e0;border-radius:8px;padding:34px 36px;display:flex;align-items:center;gap:32px"><div style="flex-shrink:0;text-align:center"><div style="font-size:34px;line-height:1;margin-bottom:8px">{{ s.emoji }}</div><div class="mono" style="font-size:60px;font-weight:700;line-height:.9;color:{{ s.stat_color }}">{{ s.stat }}</div></div><div><div style="font-size:27px;font-weight:700;line-height:1.25;text-wrap:pretty">{{ s.headline }}</div><div style="font-size:17px;color:#808080;margin-top:12px">{{ s.sub }}</div></div></div>
      {% endfor %}
    </div>
  </div>
</section>

{#================= CLOSING =================#}
<section class="slide" dir="rtl" style="background:radial-gradient(120% 120% at 50% 40%,#ffffff 0%,#f4f4f4 60%,#e6e6e6 100%);font-family:'SimplerPro',sans-serif;color:#111;padding:96px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center">
  <div style="position:absolute;top:0;left:50%;transform:translateX(-50%);width:8px;height:120px;background:#FF3300"></div>
  <div style="font-size:24px;font-weight:700;letter-spacing:.05em;color:#FF3300;margin-bottom:28px">סיכום סושיאל שבועי</div>
  <h1 style="margin:0;font-size:120px;font-weight:900;line-height:.95;letter-spacing:-.02em">נתראה בשבוע הבא</h1>
  <div style="margin-top:56px">{{ logo_lockup(56) }}</div>
  {% if reporters %}<div style="margin-top:52px;padding-top:34px;border-top:1px solid #e0e0e0;max-width:960px"><div style="font-size:15px;font-weight:700;letter-spacing:.05em;color:#FF3300;margin-bottom:16px">כתבי וכתבות השבוע</div><div style="font-size:22px;color:#111;line-height:1.7">{{ reporters | join(' · ') }}</div></div>{% endif %}
  <div style="position:absolute;bottom:64px;font-size:17px;color:#808080">מבוסס על דשבורד הסושיאל של כאן · {{ week.range_short }}</div>
</section>

</body>
</html>
