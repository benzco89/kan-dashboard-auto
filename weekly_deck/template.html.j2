<!DOCTYPE html>
<html lang="he">
<head>
<meta charset="utf-8">
{#
  Flat, self-contained render of weekly-social-light.dc.html for PDF.
  The interactive x-dc / x-import / deck-stage scaffolding is stripped: the
  <section>s are stacked vertically, each exactly 1920x1080 with a page break
  after it. Fonts come from local OTFs (weight 300 is explicitly mapped to the
  Regular file by generate_deck.py). Every image is inlined as a data URI from
  the out/thumbs cache, so rendering never touches the network.
  All values come from deck_content.json via content_to_context().
#}
<style>
{% for f in font_faces -%}
@font-face{font-family:'SimplerPro';src:url('{{ f.uri }}') format('opentype');font-weight:{{ f.weight }};font-display:swap}
{% endfor -%}
*{box-sizing:border-box}
html,body{margin:0;padding:0;background:#f4f4f4}
.slide{width:1920px;height:1080px;overflow:hidden;position:relative;page-break-after:always;break-after:page}
.slide:last-child{page-break-after:auto;break-after:auto}
/* Every number lives inside dir="rtl" Hebrew. A trailing '%' binds to the digits
   on its own, but a LEADING '+'/'−'/'×' and a separate ▲/▼ do not: bidi treats
   them as neutrals, the RTL context swallows them and they surface on the wrong
   side of the number ("112%+" instead of "+112%"). Isolating each numeric run as
   LTR is the fix — it also keeps the run from reordering the Hebrew around it. */
/* ...and direction:ltr has a second effect that is easy to miss: a block with no
   text-align takes its START from its OWN direction, so every block-level number
   drifted to the LEFT edge while the Hebrew label above it stayed on the right.
   In an RTL deck the figure belongs on the right; on inline spans this does
   nothing, so it is safe to set here once instead of on a dozen elements. */
.ltr,.mono{direction:ltr;unicode-bidi:isolate;text-align:right}
.mono{font-family:'SF Mono',Menlo,Consolas,'Courier New',monospace}
</style>
</head>
<body>

{#=== macros first, so top-level slides can call them ===#}

{#
  Brand lockup: Kan square mark (right, RTL) + SimplerPro wordmark to its left.
  Priority: pre-composed PNG > SVG mark + wordmark > pure typographic.
#}
{% macro logo_lockup(h) %}
{%- if logo_black -%}
<img src="{{ logo_black }}" alt="כאן חדשות" style="height:{{ h }}px;width:auto;opacity:.95">
{%- elif mark -%}
<div style="display:inline-flex;align-items:center;gap:{{ (h*0.32)|round|int }}px;height:{{ h }}px;font-family:'SimplerPro',sans-serif"><svg viewBox="{{ mark.viewbox }}" width="{{ h }}" height="{{ h }}" style="display:block;flex-shrink:0" role="img" aria-label="כאן חדשות"><path d="{{ mark.d }}" fill="{{ mark.fill }}"></path></svg><span style="font-size:{{ (h*0.62)|round|int }}px;line-height:1;color:#111;letter-spacing:-.02em"><span style="font-weight:900">כאן</span> <span style="font-weight:700">חדשות</span></span></div>
{%- else -%}
<div style="display:inline-flex;align-items:center;gap:{{ (h*0.28)|round|int }}px;height:{{ h }}px;opacity:.95;font-family:'SimplerPro',sans-serif"><span style="background:#111;color:#fff;font-weight:900;font-size:{{ (h*0.62)|round|int }}px;line-height:1;padding:{{ (h*0.16)|round|int }}px {{ (h*0.22)|round|int }}px;border-radius:{{ (h*0.14)|round|int }}px;letter-spacing:-.02em">כאן</span><span style="font-weight:700;font-size:{{ (h*0.5)|round|int }}px;color:#111;letter-spacing:-.01em">חדשות</span></div>
{%- endif -%}
{% endmacro %}

{# Table title cell: square (1:1) leading thumb degrades gracefully for any
   source aspect ratio at this size. #}
{# The 🎙 sits AFTER the headline, not before it: leading it pushed every radio
   row's text out of line with the rest of the column. As a flex sibling of the
   (shrinkable) text span it lands immediately after the last word — or after the
   ellipsis when the headline is cut — instead of being swallowed by the overflow
   or drifting to the far edge of the cell. #}
{% macro title_cell(row, fs, fw) -%}
<div style="display:flex;align-items:center;gap:10px;min-width:0">{% if row.thumb %}<img src="{{ row.thumb }}" alt="" style="width:34px;height:34px;object-fit:cover;object-position:center top;border-radius:6px;flex-shrink:0;background:#e8e8e8">{% endif %}<span style="font-size:{{ fs }};{% if fw %}font-weight:{{ fw }};{% endif %}white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{{ row.title }}</span>{% if row.radio %}<span title="שודר בכאן רשת ב׳" style="flex-shrink:0;font-size:19px;line-height:1;margin-inline-start:-2px">🎙</span>{% endif %}</div>
{%- endmacro %}

{# --- highlight card variants ------------------------------------------- #}

{# portrait: 4:5 slot, cover + top-anchored so faces/headlines survive #}
{% macro card_portrait(p, c) -%}
<{{ "a" if c.url else "div" }}{% if c.url %} href="{{ c.url }}"{% endif %} style="color:inherit;text-decoration:none;width:240px;height:100%;flex-shrink:0;background:#fff;border:1px solid #e0e0e0;border-radius:8px;overflow:hidden;display:flex;flex-direction:column">
  <div style="position:relative;width:100%;height:268px;flex-shrink:0;background:#e8e8e8">{% if c.thumb %}<img src="{{ c.thumb }}" alt="" style="width:100%;height:100%;object-fit:cover;object-position:center top;display:block">{% else %}<div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#eee,#e2e2e2)"><div style="opacity:.35">{{ p.icon_big }}</div></div>{% endif %}<div style="position:absolute;top:12px;right:12px;font-size:39px;filter:drop-shadow(0 2px 4px rgba(0,0,0,.6))">{{ c.medal }}</div>{% if c.radio %}<div title="רשת ב׳" style="position:absolute;top:14px;left:12px;font-size:26px;filter:drop-shadow(0 2px 4px rgba(0,0,0,.7))">🎙</div>{% endif %}</div>
  <div style="padding:10px 14px 12px;display:flex;flex-direction:column;gap:4px;flex:1"><div style="font-size:22px;font-weight:700;line-height:1.25;text-wrap:pretty;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">{{ c.title }}</div>
    {% if c.reporter %}<div style="margin-top:auto;font-size:18px;color:#606060;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;unicode-bidi:plaintext">{{ c.reporter }}</div>{% endif %}
    <div style="{% if not c.reporter %}margin-top:auto;{% endif %}display:flex;align-items:baseline;gap:5px"><span class="mono" style="font-size:32px;font-weight:700;color:{{ p.colors.accent }}">{{ c.views_fmt }}</span><span style="font-size:17px;color:#808080">צפיות</span></div></div>
</{{ "a" if c.url else "div" }}>
{%- endmacro %}

{# blur: original wide slot; image is contained (never cropped) over a blurred,
   scaled-up, darkened copy of itself #}
{% macro card_blur(p, c) -%}
<{{ "a" if c.url else "div" }}{% if c.url %} href="{{ c.url }}"{% endif %} style="color:inherit;text-decoration:none;background:#fff;border:1px solid #e0e0e0;border-radius:8px;overflow:hidden;position:relative;display:flex;flex-direction:column">
  <div style="position:relative;width:100%;height:172px;background:#e8e8e8;overflow:hidden">{% if c.thumb %}<div style="position:absolute;inset:0;background-image:url('{{ c.thumb }}');background-size:cover;background-position:center;filter:blur(30px) brightness(.62);transform:scale(1.25)"></div><img src="{{ c.thumb }}" alt="" style="position:relative;width:100%;height:100%;object-fit:contain;display:block">{% else %}<div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#eee,#e2e2e2)"><div style="opacity:.35">{{ p.icon_big }}</div></div>{% endif %}<div style="position:absolute;top:14px;right:14px;font-size:44px;filter:drop-shadow(0 2px 4px rgba(0,0,0,.6))">{{ c.medal }}</div>{% if c.radio %}<div title="רשת ב׳" style="position:absolute;top:16px;left:14px;font-size:28px;filter:drop-shadow(0 2px 4px rgba(0,0,0,.7))">🎙</div>{% endif %}</div>
  <div style="padding:14px 22px 16px;display:flex;flex-direction:column;gap:8px;flex:1"><div style="font-size:26px;font-weight:700;line-height:1.2;text-wrap:pretty">{{ c.title }}</div>
    <div style="margin-top:auto;display:flex;align-items:center;justify-content:space-between"><div style="display:flex;align-items:baseline;gap:7px"><span class="mono" style="font-size:39px;font-weight:700;color:{{ p.colors.accent }}">{{ c.views_fmt }}</span><span style="font-size:20px;color:#808080">צפיות</span></div>{% if c.reporter %}<div style="font-size:20px;color:#808080;display:flex;align-items:center;gap:7px"><span style="width:6px;height:6px;border-radius:50%;background:#FF3300"></span>{{ c.reporter }}</div>{% endif %}</div></div>
</{{ "a" if c.url else "div" }}>
{%- endmacro %}

{# text-forward: no image area at all (X). The tweet itself is the hero. #}
{% macro card_text(p, c) -%}
<{{ "a" if c.url else "div" }}{% if c.url %} href="{{ c.url }}"{% endif %} style="color:inherit;text-decoration:none;background:#fff;border:1px solid #e0e0e0;border-radius:8px;position:relative;overflow:hidden;display:flex;flex-direction:column;min-height:262px;padding:26px 30px 22px">
  <div style="position:absolute;top:0;right:0;width:4px;height:100%;background:{{ p.colors.accent }}"></div>
  <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:12px"><div style="display:flex;align-items:center;gap:10px"><div style="font-size:37px;filter:drop-shadow(0 2px 4px rgba(0,0,0,.35))">{{ c.medal }}</div>{% if c.radio %}<div title="רשת ב׳" style="font-size:26px">🎙</div>{% endif %}</div><div class="mono" style="font-size:54px;line-height:.7;color:{{ p.colors.accent }};opacity:.25">&rdquo;</div></div>
  <div style="font-size:28px;font-weight:700;line-height:1.3;text-wrap:pretty;display:-webkit-box;-webkit-line-clamp:5;-webkit-box-orient:vertical;overflow:hidden">{{ c.title }}</div>
  <div style="margin-top:auto;padding-top:18px;display:flex;align-items:center;justify-content:space-between;border-top:1px solid #ececec"><div style="display:flex;align-items:baseline;gap:7px"><span class="mono" style="font-size:39px;font-weight:700;color:{{ p.colors.accent }}">{{ c.views_fmt }}</span><span style="font-size:20px;color:#808080">צפיות</span></div>{% if c.reporter %}<div style="font-size:20px;color:#808080;display:flex;align-items:center;gap:7px"><span style="width:6px;height:6px;border-radius:50%;background:#FF3300"></span>{{ c.reporter }}</div>{% endif %}</div>
</{{ "a" if c.url else "div" }}>
{%- endmacro %}

{#
  Fun-fact panel: the chosen candidate is the hero (big number + sentence), and
  the runners-up from fun_fact.candidates sit underneath as a compact muted
  list — real per-platform numbers instead of empty space.
#}
{% macro funfact_box(p, tall) -%}
{% if p.fun_fact %}<div style="{% if tall %}flex:1;{% else %}width:296px;flex-shrink:0;{% endif %}background:linear-gradient(180deg,rgba({{ p.colors.tint }},.10),rgba({{ p.colors.tint }},.02));border:1px solid rgba({{ p.colors.tint }},.28);border-radius:8px;padding:{% if tall %}26px 34px 22px{% else %}26px{% endif %};display:flex;flex-direction:column;{% if not tall %}justify-content:center;{% endif %}overflow:hidden">
  <div style="font-size:20px;font-weight:700;letter-spacing:.04em;color:{{ p.colors.accent }};margin-bottom:{% if tall %}12px{% else %}16px{% endif %}">נתון מעניין</div>
  <div class="mono" style="font-size:{% if tall %}78px{% else %}68px{% endif %};font-weight:700;line-height:.9;color:#111">{{ p.fun_fact.value }}<span style="font-size:{% if tall %}44px{% else %}41px{% endif %};color:{{ p.colors.accent }}">{{ p.fun_fact.suffix }}</span></div>
  <div style="font-size:{% if tall %}27px{% else %}25px{% endif %};line-height:1.4;color:#404040;margin-top:14px;text-wrap:pretty;{% if tall %}max-width:620px{% endif %}">{{ p.fun_fact.text }}</div>
  {% if p.fun_fact_more %}<div style="{% if tall %}margin-top:auto;{% endif %}padding-top:{% if tall %}18px{% else %}24px{% endif %}">
    {# the tall panel shares a fixed-height band with the highlight cards, so it
       carries two runners-up, not three — a third would be clipped, not read #}
    {% for m in (p.fun_fact_more[:2] if tall else p.fun_fact_more) %}<div style="display:flex;align-items:baseline;justify-content:space-between;gap:12px;padding:{% if tall %}9px{% else %}9px{% endif %} 0;border-top:1px solid rgba({{ p.colors.tint }},.24)">
      {#- figure first, like the חריג badge: "10K שיתופים", not "שיתופים ... 10K" -#}
      <span class="mono" style="font-size:{% if tall %}31px{% else %}25px{% endif %};font-weight:700;color:#404040;white-space:nowrap;flex-shrink:0">{{ m.value }}<span style="font-size:{% if tall %}21px{% else %}17px{% endif %};color:{{ p.colors.accent }}">{{ m.suffix }}</span></span>
      <span style="font-size:{% if tall %}23px{% else %}20px{% endif %};color:#808080;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;text-align:left">{{ m.label }}</span>
    </div>{% endfor %}
  </div>{% endif %}
</div>{% endif %}
{%- endmacro %}

{#
  One row macro instead of three near-identical copies: the highlight / anomaly /
  plain variants differ only in weight and background, and adding a column used
  to mean editing the same grid three times.

  The whole row is an <a> when the item has a link. Chromium's page.pdf() turns
  those into real PDF link annotations, so the exported deck is clickable —
  verified, not assumed.
#}
{% macro table_row(p, row, cols) -%}
{%- if row.highlight -%}
  {%- set bg = "rgba(%s,%s)"|format(p.colors.tint, {1:'0.16',2:'0.11',3:'0.07'}[row.rank]) -%}
  {%- set edge, pad, rank_fs, rank_w, rank_c = p.colors.bar, "4px", "29px", "700", "#111" -%}
  {%- set t_fs, t_fw, meta_c, v_fs, v_fw = p.title_fs_hi, "600", "#404040", "27px", "700" -%}
{%- elif row.anomaly -%}
  {%- set bg, edge, pad = "rgba(255,51,0,0.07)", "#FF3300", "4px" -%}
  {%- set rank_fs, rank_w, rank_c = "26px", "400", "#808080" -%}
  {%- set t_fs, t_fw, meta_c, v_fs, v_fw = p.title_fs, "", "#808080", "26px", "400" -%}
{%- else -%}
  {%- set bg, edge, pad = "", "", "3px" -%}
  {%- set rank_fs, rank_w, rank_c = "26px", "400", "#808080" -%}
  {%- set t_fs, t_fw, meta_c, v_fs, v_fw = p.title_fs, "", "#808080", "26px", "400" -%}
{%- endif -%}
<{{ "a" if row.url else "div" }}{% if row.url %} href="{{ row.url }}"{% endif %} style="color:inherit;text-decoration:none;display:grid;grid-template-columns:{{ cols }};gap:14px;align-items:center;padding:{{ pad }} 18px;{% if bg %}background:{{ bg }};border-right:3px solid {{ edge }};border-radius:4px{% else %}border-bottom:1px solid #e0e0e0{% endif %}">
  <div class="mono" style="font-size:{{ rank_fs }};font-weight:{{ rank_w }};color:{{ rank_c }}">{{ row.rank }}</div>
  {{ title_cell(row, t_fs, t_fw) }}
  <div style="font-size:21px;color:{{ meta_c }};white-space:nowrap;overflow:hidden;text-overflow:ellipsis;unicode-bidi:plaintext">{{ row.reporter }}</div>
  {% if p.show_program %}<div style="font-size:19px;color:{{ meta_c }};white-space:nowrap;overflow:hidden;text-overflow:ellipsis;unicode-bidi:plaintext">{{ row.program }}</div>{% endif %}
  <div class="mono" style="text-align:right;font-size:{{ v_fs }};font-weight:{{ v_fw }}">{{ row.views_fmt }}</div>
  {% for c in row.cells %}<div class="mono" style="text-align:right;font-size:{{ p.cell_fs }};color:#404040">{{ c }}</div>{% endfor %}
  <div style="text-align:right">{% if row.anomaly %}<span style="display:inline-flex;align-items:center;gap:5px;font-size:18px;font-weight:700;color:#fff;background:#FF3300;border-radius:99px;padding:3px 10px;white-space:nowrap"><span style="font-size:17px">{{ row.anomaly.icon }}</span>{{ row.anomaly.mult }} {{ row.anomaly.label }}</span>{% endif %}</div>
</{{ "a" if row.url else "div" }}>
{%- endmacro %}

{% macro table_block(p) -%}
{#- an emoji header is what buys the extra columns: "שיתופים" at 20px bold needs
    ~75px, the number under it needs 78px, so a word header would have set the
    column width and cost the כותרת column another 20px each. The icons are the
    ones the חריג badge already uses, and the overview slide spells them out. -#}
{%- set cols = "46px 1fr 208px " + ("158px " if p.show_program else "") + "104px " + ("78px " * (p.int_cols|length)) + "178px" -%}
<div style="display:grid;grid-template-columns:{{ cols }};gap:14px;padding:0 18px 6px;font-size:20px;font-weight:700;color:#808080;letter-spacing:.03em"><div>#</div><div>כותרת</div><div>כתב/ת</div>{% if p.show_program %}<div>תוכנית</div>{% endif %}<div style="text-align:right">צפיות</div>{% for c in p.int_cols %}<div style="text-align:right;font-size:22px" title="{{ c.label }}">{{ c.icon }}</div>{% endfor %}<div style="text-align:right">חריג</div></div>
<div style="display:flex;flex-direction:column;gap:4px;flex:1">
  {% for row in p.top10 %}{{ table_row(p, row, cols) }}{% endfor %}
</div>
{%- endmacro %}

{% macro platform_slide(p) %}
<section class="slide" dir="rtl" style="background:#f4f4f4;font-family:'SimplerPro',sans-serif;color:#111;padding:46px 72px 40px;display:flex;flex-direction:column">
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px"><div style="display:flex;align-items:center;gap:20px">{{ p.icon }}<div><div style="font-size:20px;font-weight:700;letter-spacing:.05em;color:#FF3300">{{ p.rank_label }}</div><h2 style="margin:2px 0 0;font-size:51px;font-weight:900;letter-spacing:-.02em">{{ p.name }}</h2></div></div>
    <div style="display:flex;gap:44px;align-items:center"><div style="text-align:right"><div class="mono" style="font-size:51px;font-weight:700;line-height:1">{{ p.weekly_views_fmt }}</div><div style="font-size:20px;color:#808080;margin-top:4px">צפיות השבוע</div></div><div style="width:1px;height:50px;background:#e0e0e0"></div><div style="text-align:right"><div class="mono" style="font-size:51px;font-weight:700;line-height:1;color:{{ p.delta_color }}">{% if p.has_delta %}{{ p.delta_str }}{% else %}—{% endif %}</div><div style="font-size:20px;color:#808080;margin-top:4px">ביחס לשבוע שעבר</div></div></div></div>

  {% if not p.has_data %}
  <div style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#808080;gap:18px">
    <div style="opacity:.45">{{ p.icon_big }}</div>
    <div style="font-size:37px;font-weight:700;color:#404040">אין פרסומים ב{{ p.name }} השבוע</div>
    <div style="font-size:25px">לא נאספו נתונים לחלון {{ week.range_short }}</div>
  </div>

  {% elif p.text_cards %}
  {#--- X: text-forward highlight cards, no image slots ---#}
  <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-bottom:18px">{% for c in p.top3 %}{{ card_text(p, c) }}{% endfor %}</div>
  <div style="flex:1;display:flex;gap:22px;min-height:0"><div style="flex:1;display:flex;flex-direction:column;min-height:0">{{ table_block(p) }}</div>{{ funfact_box(p, false) }}</div>

  {% elif thumbstyle == 'portrait' %}
  {#--- portrait: taller/narrower cards beside a wide fun-fact; table full width ---#}
  <div style="display:flex;gap:18px;margin-bottom:10px;flex-shrink:0;height:412px">
    <div style="display:flex;gap:22px;flex-shrink:0">{% for c in p.top3 %}{{ card_portrait(p, c) }}{% endfor %}</div>
    {{ funfact_box(p, true) }}
  </div>
  <div style="flex:1;display:flex;flex-direction:column;min-height:0">{{ table_block(p) }}</div>

  {% else %}
  {#--- blur: original wide layout, nothing ever cropped ---#}
  <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-bottom:18px">{% for c in p.top3 %}{{ card_blur(p, c) }}{% endfor %}</div>
  <div style="flex:1;display:flex;gap:22px;min-height:0"><div style="flex:1;display:flex;flex-direction:column;min-height:0">{{ table_block(p) }}</div>{{ funfact_box(p, false) }}</div>
  {% endif %}
</section>
{% endmacro %}

{#================= COVER =================#}
<section class="slide" dir="rtl" style="background:radial-gradient(120% 120% at 78% 12%,#ffffff 0%,#f7f7f7 55%,#ececec 100%);font-family:'SimplerPro',sans-serif;color:#111;padding:96px 110px;display:flex;flex-direction:column;justify-content:space-between">
  <div style="position:absolute;top:0;right:0;width:8px;height:100%;background:#FF3300"></div>
  <div style="display:flex;align-items:flex-start;justify-content:space-between">
    <div>
      <div style="font-size:29px;font-weight:700;letter-spacing:.04em;color:#FF3300;margin-bottom:26px">סיכום סושיאל שבועי</div>
      <h1 style="margin:0;font-size:104px;font-weight:900;line-height:.98;letter-spacing:-.02em">הסושיאל<br>של השבוע</h1>
      <div style="margin-top:30px;font-size:37px;font-weight:400;color:#404040">{{ week.range_str }}</div>
    </div>
    {{ logo_lockup(58) }}
  </div>
  <div style="display:flex;align-items:flex-end;justify-content:space-between;border-top:1px solid #e0e0e0;padding-top:44px">
    <div>
      <div style="font-size:31px;font-weight:600;color:#808080;margin-bottom:8px">סה״כ צפיות בכל הפלטפורמות</div>
      <div class="mono" style="font-size:200px;font-weight:700;line-height:.85;letter-spacing:-.03em;color:#111">{{ hero.total_main }}<span style="font-size:96px;color:#FF3300">{{ hero.total_suffix }}</span></div>
    </div>
    {% if hero.has_delta %}<div style="text-align:right;display:flex;align-items:center;gap:12px;color:{{ hero.delta_color }};font-size:37px;font-weight:700"><span class="ltr" style="display:inline-flex;align-items:center;gap:12px"><span style="font-size:41px">{{ hero.delta_arrow }}</span>{{ hero.delta_str }}</span> ביחס לשבוע שעבר</div>{% endif %}
  </div>
</section>

{#================= OVERVIEW =================#}
<section class="slide" dir="rtl" style="background:#f4f4f4;font-family:'SimplerPro',sans-serif;color:#111;padding:84px 96px;display:flex;flex-direction:column">
  <div style="display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:8px">
    <div style="display:flex;align-items:baseline;gap:20px"><div style="width:44px;height:8px;background:#FF3300;align-self:center"></div><h2 style="margin:0;font-size:66px;font-weight:900;letter-spacing:-.02em">השבוע במספרים</h2></div>
    <div style="text-align:right"><div class="mono" style="font-size:64px;font-weight:700;line-height:1">{{ hero.total_fmt }}</div><div style="font-size:24px;color:#808080;margin-top:4px">סה״כ צפיות{% if hero.has_delta %} · <span class="ltr" style="color:{{ hero.delta_color }};font-weight:700">{{ hero.delta_arrow }} {{ hero.delta_str }}</span> ביחס לשבוע שעבר{% endif %}</div></div></div>
  {# A key, not a manual. Only the marks a reader cannot decode on sight stay:
     the badge, the column icons, and the microphone on a week that has radio.
     What the bars mean, and that rows are clickable, explain themselves. #}
  <div style="display:flex;align-items:center;gap:12px 28px;flex-wrap:wrap;font-size:23px;color:#808080;margin:6px 0 22px">
    <span style="display:inline-flex;align-items:center;gap:9px"><span style="font-size:19px;font-weight:700;color:#fff;background:#FF3300;border-radius:99px;padding:3px 12px">חריג</span> פי {{ anomaly_min }} ומעלה מהרגיל <b>ביחס לצפיות שלו</b></span>
    {#- no emoji inside the prose: an icon next to the Latin "X" is a neutral
        character beside an LTR run, which is how it ends up on the wrong side
        of the word. The icons stay in their own run, the caveats use words. -#}
    <span>❤️ לייקים · 💬 תגובות · 🔁 שיתופים</span>
    {%- if has_radio %}
    <span>🎙 שודר ב<b>כאן רשת ב׳</b></span>
    {%- endif %}
  </div>
  <div style="display:grid;grid-template-columns:280px 1fr 155px 130px;gap:26px;padding:0 2px 16px;border-bottom:1px solid #e0e0e0;font-size:22px;font-weight:700;color:#808080;letter-spacing:.03em"><div>פלטפורמה</div><div>נתח מסך הצפיות</div><div style="text-align:right">צפיות השבוע</div><div style="text-align:right">מגמה</div></div>
  <div style="flex:1;display:flex;flex-direction:column;justify-content:space-around;padding:10px 0">
    {% for r in overview_rows %}<div style="display:grid;grid-template-columns:280px 1fr 155px 130px;gap:26px;align-items:center">
      <div style="display:flex;align-items:center;gap:16px">{{ r.icon }}<div><div style="font-size:38px;font-weight:700">{{ r.name }}</div><div style="font-size:23px;color:#808080;margin-top:3px">{% if r.followers_fmt %}{{ r.followers_fmt }} עוקבים{% endif %}</div></div></div>
      <div style="position:relative;height:48px;background:#e0e0e0;border-radius:8px;overflow:hidden"><div style="position:absolute;top:0;right:0;height:100%;width:{{ r.bar_pct }}%;background:{{ r.bar_color }};border-radius:8px"></div></div>
      <div class="mono" style="font-size:45px;font-weight:700">{{ r.views_fmt }}</div>
      <div style="font-size:27px;font-weight:700;color:{{ r.delta_color }};text-align:right">{% if r.has_delta %}<span class="ltr">{{ r.delta_arrow }} {{ r.delta_str }}</span>{% else %}—{% endif %}</div></div>
    {% endfor %}
  </div>
</section>

{#================= PLATFORM SLIDES =================#}
{% for p in platforms %}{{ platform_slide(p) }}{% endfor %}

{#================= LEARNINGS =================#}
<section class="slide" dir="rtl" style="background:radial-gradient(120% 120% at 22% 10%,#ffffff 0%,#f4f4f4 60%,#e9e9e9 100%);font-family:'SimplerPro',sans-serif;color:#111;padding:72px 96px;display:flex;flex-direction:column">
  <div style="display:flex;align-items:baseline;gap:20px;margin-bottom:32px;flex-shrink:0"><div style="width:44px;height:8px;background:#FF3300;align-self:center"></div><h2 style="margin:0;font-size:66px;font-weight:900;letter-spacing:-.02em">מה קרה השבוע</h2></div>

  {#--- story of the week takes the freed vertical space; its per-platform
       numbers are the strongest thing on the slide, so they get real size ---#}
  {% if story %}
  <div style="background:#fff;border:1px solid #e0e0e0;border-radius:8px;padding:44px 48px;position:relative;overflow:hidden;margin-bottom:32px;flex:1;min-height:300px;max-height:452px;display:flex;align-items:center;gap:52px">
    <div style="position:absolute;top:0;right:0;width:8px;height:100%;background:#FF3300"></div>
    <div style="flex:1;min-width:0">
      <div style="font-size:21px;font-weight:700;letter-spacing:.05em;color:#FF3300;margin-bottom:16px">הסיפור של השבוע</div>
      <div style="font-size:57px;font-weight:900;line-height:1.1;letter-spacing:-.015em;text-wrap:pretty">{{ story.title }}</div>
      <div style="font-size:31px;color:#404040;line-height:1.5;margin-top:20px;text-wrap:pretty">{{ story.sentence }}</div>
    </div>
    {#- four bare numbers in a row read as one figure broken up. Each platform
        gets its own tile: its mark, a rule in its own colour, and the name under
        the number — so the block says "four platforms" before it is read. -#}
    {% if story.platforms %}<div style="display:flex;gap:22px;flex-shrink:0;padding-right:44px;border-right:1px solid #ececec">
      {% for s in story.platforms %}<div style="text-align:right;background:#fafafa;border:1px solid #ececec;border-radius:10px;padding:18px 22px 16px;min-width:168px">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px"><div style="font-size:22px;font-weight:700;color:#404040">{{ s.name }}</div>{% if s.icon %}<div style="line-height:0;flex-shrink:0">{{ s.icon }}</div>{% endif %}</div>
        <div style="height:3px;background:{{ s.accent }};border-radius:2px;margin-bottom:12px"></div>
        <div class="mono" style="font-size:54px;font-weight:700;line-height:1;letter-spacing:-.02em">{{ s.views_fmt }}</div>
        <div style="font-size:19px;color:#909090;margin-top:6px">צפיות</div>
      </div>{% endfor %}
    </div>{% endif %}
  </div>
  {% endif %}

  {#--- cards hug their content (align-items:start) so there is never a hole
       inside a card; without a story band they centre in the leftover space ---#}
  <div style="display:grid;grid-template-columns:repeat({{ learnings|length or 1 }},1fr);gap:24px;align-items:start;flex-shrink:0;margin:auto 0">
    {#- text-align is explicit because .mono carries direction:ltr, and a block
        with no text-align takes its START from its own direction — which put the
        number on the left of every card while the icon stayed on the right. -#}
    {% for c in learnings %}<div style="background:#fff;border:1px solid #e0e0e0;border-radius:8px;padding:{% if story %}34px 32px 36px{% else %}44px 40px{% endif %};display:flex;flex-direction:column;overflow:hidden;text-align:right">
      {#- the figure leads (RTL start) and the icon closes the line: stacked, the
          number sat under the icon and pulled the eye across the card. -#}
      <div style="display:flex;align-items:center;justify-content:space-between;gap:16px">
        {% if c.number %}<div class="mono" style="font-size:{% if story %}59px{% else %}88px{% endif %};font-weight:700;line-height:.9;color:{{ c.color }}">{{ c.number_main }}<span style="font-size:{% if story %}37px{% else %}53px{% endif %}">{{ c.number_suffix }}</span></div>{% else %}<div></div>{% endif %}
        <div style="font-size:{% if story %}37px{% else %}51px{% endif %};line-height:1;flex-shrink:0">{{ c.icon }}</div>
      </div>
      <div style="font-size:{% if story %}29px{% else %}37px{% endif %};font-weight:900;line-height:1.2;letter-spacing:-.01em;margin-top:{% if story %}14px{% else %}22px{% endif %};text-wrap:pretty">{{ c.title }}</div>
      <div style="margin-top:12px;font-size:{% if story %}21px{% else %}25px{% endif %};color:#808080;line-height:1.55;text-wrap:pretty">{{ c.sentence }}</div>
    </div>{% endfor %}
  </div>
</section>

{#================= CLOSING =================#}
<section class="slide" dir="rtl" style="background:radial-gradient(120% 120% at 50% 40%,#ffffff 0%,#f4f4f4 60%,#e6e6e6 100%);font-family:'SimplerPro',sans-serif;color:#111;padding:96px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center">
  <div style="position:absolute;top:0;left:50%;transform:translateX(-50%);width:8px;height:120px;background:#FF3300"></div>
  <div style="font-size:31px;font-weight:700;letter-spacing:.05em;color:#FF3300;margin-bottom:28px">סיכום סושיאל שבועי</div>
  <h1 style="margin:0;font-size:120px;font-weight:900;line-height:.95;letter-spacing:-.02em">נתראה בשבוע הבא</h1>
  <div style="margin-top:56px">{{ logo_lockup(56) }}</div>
  
  <div style="position:absolute;bottom:64px;font-size:22px;color:#808080">{{ closing_note }}{% if week.range_short %} · {{ week.range_short }}{% endif %}</div>
</section>

</body>
</html>
