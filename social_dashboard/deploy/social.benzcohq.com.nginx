# social.benzcohq.com — Kan social dashboard (behind Authelia SSO, same as pushstat).
# Written with `listen 80` only; `certbot --nginx -d social.benzcohq.com` adds the
# 443 server block + http->https redirect on first run.
server {
    server_name social.benzcohq.com;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    client_max_body_size 10m;

    include /etc/nginx/snippets/authelia-location.conf;

    # ציבורי בכוונה, ומצומצם לשני הנתיבים האלה בלבד: גוגל דורשת דף בית
    # ומדיניות פרטיות נגישים כדי לפרסם אפליקציית OAuth חיצונית. ^~ מבטיח
    # שההתאמה הזו גוברת ואינה נופלת ל-location / שמאחורי Authelia.
    location ^~ /archive/ {
        alias /var/www/kan-archive/;
        index index.html;
        autoindex off;
        add_header X-Robots-Tag "noindex, nofollow" always;
    }

    location = /archive {
        return 301 /archive/;
    }

    location / {
        include /etc/nginx/snippets/authelia-authrequest.conf;
        proxy_pass http://127.0.0.1:8430;
        proxy_read_timeout 120s;
    }

    listen [::]:443 ssl; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/social.benzcohq.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/social.benzcohq.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}

server {
    if ($host = social.benzcohq.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    server_name social.benzcohq.com;

    listen 80;
    listen [::]:80;
    return 404; # managed by Certbot


}